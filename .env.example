# OMNIA Environment Variables
# Copy this to .env and fill in your values

# Application
NODE_ENV=development
API_PORT=3001
NEXT_PUBLIC_API_URL=http://localhost:3001

# Google Gemini (Required)
GEMINI_API_KEY=AQ.Ab8RN6L5Tj7Nl--SAK1YwQpnAOaVvm_gcoRhfCV8_B7k511N0Q
GEMINI_MODEL=gemini-1.5-pro

# Database (Supabase) - Required
DATABASE_URL=postgresql://user:pass@host:5432/db
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Web Search (Google Custom Search) - Required
WEB_SEARCH_API_KEY=your-google-api-key
WEB_SEARCH_ENGINE_ID=your-search-engine-id

# Meko MCP (Optional)
MEKO_MCP_URL=https://your-meko-instance.com/mcp
MEKO_MCP_AUTH_TOKEN=your-auth-token